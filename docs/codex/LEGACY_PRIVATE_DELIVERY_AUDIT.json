  "required_private_pipeline": [
    {
      "stage": "Seal and map",
      "requirement": "Retain every canonical ID, full/content hash, bundle membership and original asset; verify private rights and exact class/course-version mappings without inventing trust or collapsing BC/enrichment into AB."
    },
    {
      "stage": "Immutable private staging",
      "requirement": "Do not invoke current uploaders for dry runs: they upsert, upload and delete stale records. Use immutable package versions, organization/version media namespaces and transactional activation only after complete payload/media integrity checks."
    },
    {
      "stage": "Authority",
      "requirement": "Practice-bank-api delivery must revalidate active same-organization class, account/session, membership, active version pin and class-specific release. Existing course-only checks and package status labels are insufficient for these claims."
    },
    {
      "stage": "Preserve authenticated delivery",
      "requirement": "Verify real private inventory and all 5,882 preserved records/media, including current student-route parity, before removing static availability. Keep the existing practice URLs and successful private API behavior."
    },
    {
      "stage": "Test before cutover",
      "requirement": "Actual PostgreSQL + handler/transport/SQL negatives for grants, tenants, session expiry/revocation, inactive class/membership/pin, unpublished/partial snapshots, CAS/rollback/concurrency and missing/corrupt media; browser preservation/lifecycle/cache tests."
    },
    {
      "stage": "Public cutover",
      "requirement": "Only after accepted coverage, remove legacy payload/media roots from Pages, keep safe metadata/URL shells, remove public static fallback and purge/deny stale service-worker paths. Preserve official 1,104 independently. Rollback uses a verified private snapshot, never public raw data."
    }
  ],
