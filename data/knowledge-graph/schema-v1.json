{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2ed944-cloud.github.io/ECHS-Math/data/knowledge-graph/schema-v1.json",
  "title": "ECHS Mathematics Atomic Skill Graph",
  "type": "object",
  "required": ["schema_version", "course", "unit", "skills"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "course": {"type": "string", "minLength": 1},
    "unit": {"type": ["string", "integer"]},
    "title": {"type": "string"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "lesson_ids", "prerequisites", "representations", "misconceptions", "evidence_rules"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9._-]+$"},
          "title": {"type": "string", "minLength": 3},
          "description": {"type": "string", "minLength": 10},
          "ap_topics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "lesson_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "prerequisites": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "representations": {"type": "array", "items": {"enum": ["symbolic", "graphical", "numerical", "verbal", "tabular", "contextual"]}, "minItems": 1, "uniqueItems": true},
          "misconceptions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_rules": {
            "type": "object",
            "required": ["minimum_independent", "minimum_days", "requires_transfer", "requires_retention"],
            "properties": {
              "minimum_independent": {"type": "integer", "minimum": 1},
              "minimum_days": {"type": "integer", "minimum": 1},
              "requires_transfer": {"type": "boolean"},
              "requires_retention": {"type": "boolean"},
              "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
