# LOW-COST LOCAL-FIRST ENVIRONMENT
# Copy only the variables you actually need into your local OpenClaw environment.
# NEVER commit the real values.

# Preferred model auth for launch:
# Use ChatGPT/Codex OAuth interactively:
#   openclaw models auth login --provider openai
# This can use eligible ChatGPT/Codex subscription quota for agent reasoning,
# avoiding separate API billing for ordinary WhatsApp and sales-reasoning turns.

# Realtime Google Meet transcription in agent mode still requires a realtime provider key.
# Keep this project-scoped and set a small monthly budget/alert.
OPENAI_API_KEY=REPLACE_ONLY_WHEN_MEET_VOICE_IS_ENABLED

# Optional usage reporting if you intentionally configure it.
# OPENAI_PROJECT_ID=
# OPENAI_ADMIN_KEY=

# Optional Google Meet API creation path. A signed-in Chrome browser can be used instead.
# OPENCLAW_GOOGLE_MEET_CLIENT_ID=
# OPENCLAW_GOOGLE_MEET_CLIENT_SECRET=
# OPENCLAW_GOOGLE_MEET_REFRESH_TOKEN=

# No TTS API key is required in the launch configuration:
# Microsoft neural TTS is the default best-effort no-key speech provider.

# Optional future PSTN fallback only. Do not configure at launch unless needed.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
