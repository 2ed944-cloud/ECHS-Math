# Copy to the OpenClaw runtime repository as .env on the VPS.
# NEVER commit the real .env file.

# Use a pinned release/digest in production after the first verified smoke test.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# Docker Gateway runtime. Host port must remain bound to 127.0.0.1 only.
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME_WITH_64_HEX_CHARS
OPENCLAW_DISABLE_BONJOUR=1

# Persistent host state.
OPENCLAW_CONFIG_DIR=/home/openclaw/.openclaw
OPENCLAW_WORKSPACE_DIR=/home/openclaw/.openclaw/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=/home/openclaw/.openclaw-auth-profile-secrets
GOG_KEYRING_PASSWORD=CHANGE_ME_WITH_64_HEX_CHARS
XDG_CONFIG_HOME=/home/node/.config

# Model + realtime transcription + OpenAI TTS.
# API billing is separate from a ChatGPT subscription.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_PROJECT_KEY

# Optional Google Meet OAuth creation path. Browser fallback can be used instead.
# OPENCLAW_GOOGLE_MEET_CLIENT_ID=
# OPENCLAW_GOOGLE_MEET_CLIENT_SECRET=
# OPENCLAW_GOOGLE_MEET_REFRESH_TOKEN=

# Optional PSTN / Meet dial-in fallback. Leave unset until intentionally enabled.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
