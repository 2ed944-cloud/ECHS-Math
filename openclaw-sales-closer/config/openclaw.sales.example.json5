// Merge this into ~/.openclaw/openclaw.json.
// Keep API keys, OAuth tokens and phone-provider credentials in environment/secret stores.
{
  agents: {
    entries: {
      "echs-sales-closer": {
        name: "ECHS AI Sales Closer",
        workspace: "~/.openclaw/workspace-echs-sales",
        identity: {
          name: "Platform AI Sales Specialist",
          theme: "precise consultative school sales",
          emoji: "∫",
        },
        // The sales agent does not need arbitrary host execution or self-modification.
        tools: {
          deny: ["exec", "process", "write", "edit", "apply_patch"],
        },
        heartbeat: {
          every: "30m",
          target: "none",
          prompt: "Review only actionable sales state: meetings in the next 24 hours that lack preparation; promised follow-ups due for consented active deals; proposals past an explicitly agreed decision date; closed-won onboarding handoffs; unresolved factual or technical questions; and channel/integration failures. Do not create marketing contact merely because a lead is idle. Never contact DO_NOT_MARKET. Recurring schedules belong in automations. If nothing is actionable, reply HEARTBEAT_OK.",
        },
      },
    },
  },

  bindings: [
    {
      agentId: "echs-sales-closer",
      match: { channel: "whatsapp", accountId: "biz" },
    },
  ],

  channels: {
    whatsapp: {
      enabled: true,
      defaultAccount: "biz",
      accounts: {
        biz: {
          // Public business inbox: new prospects can message without manual pairing.
          // Sales policy still forbids unsolicited outbound marketing without consent.
          dmPolicy: "open",
          allowFrom: ["*"],
          sendReadReceipts: true,
        },
      },
      // Sales happens in 1:1 conversations; fail closed for groups.
      groupPolicy: "disabled",
    },
  },

  plugins: {
    entries: {
      "google-meet": {
        enabled: true,
        config: {
          // Local Chrome requires a supported macOS/Linux desktop audio environment.
          // For a remote Gateway, use a paired chrome-node instead.
          defaultTransport: "chrome",
          defaultMode: "agent",
          chrome: {
            guestName: "Platform AI Sales Specialist",
            autoJoin: true,
          },
          realtime: {
            transcriptionProvider: "openai",
            agentId: "echs-sales-closer",
            toolPolicy: "safe-read-only",
            instructions: "Speak concisely and answer the buyer's question first. You are an AI sales specialist. Use the configured OpenClaw agent for factual, product and commercial reasoning.",
            introMessage: "Say exactly: Hello. I'm the AI sales specialist for the mathematics learning platform. I use live transcription so I can participate accurately in this meeting. If anyone is not comfortable with transcription, please tell me before we continue.",
          },
        },
      },
    },
  },

  // Critical for a customer-facing inbox: no prospect can see another prospect's context.
  session: {
    dmScope: "per-account-channel-peer",
    resetByType: {
      direct: { mode: "idle", idleMinutes: 720 },
    },
  },
}
